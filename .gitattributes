# Normalizar automáticamente los archivos de texto en Git
* text=auto

# Código, documentación y configuración con LF en el árbol de trabajo
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env* text eol=lf
.gitkeep text eol=lf

# Scripts de comandos de Windows con CRLF en el árbol de trabajo
*.[bB][aA][tT] text eol=crlf
*.[cC][mM][dD] text eol=crlf
